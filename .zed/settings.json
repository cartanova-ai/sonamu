{
  "project_name": "Sonamu",
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "tsserver": { "maxTsServerMemory": 16184 },
          "inlayHints": {
            "parameterNames": {
              "enabled": "all",
              "suppressWhenArgumentMatchesName": false
            },
            "parameterTypes": {
              "enabled": true
            },
            "variableTypes": {
              "enabled": true,
              "suppressWhenTypeMatchesName": true
            },
            "propertyDeclarationTypes": {
              "enabled": true
            },
            "functionLikeReturnTypes": {
              "enabled": true
            },
            "enumMemberValues": {
              "enabled": true
            }
          }
        },
        "javascript": {
          "tsserver": { "maxTsServerMemory": 16184 },
          "inlayHints": {
            "parameterNames": {
              "enabled": "all",
              "suppressWhenArgumentMatchesName": false
            },
            "parameterTypes": {
              "enabled": true
            },
            "variableTypes": {
              "enabled": true,
              "suppressWhenTypeMatchesName": true
            },
            "propertyDeclarationTypes": {
              "enabled": true
            },
            "functionLikeReturnTypes": {
              "enabled": true
            },
            "enumMemberValues": {
              "enabled": true
            }
          }
        },
        "vtsls": {
          "experimental": {
            "maxInlayHintLength": 25
          }
        }
      }
    },
    "tailwindcss-language-server": {
      "settings": {}
    }
  },
  "file_scan_exclusions": [
    ".git/",
    "**/node_modules",
    "packages/app",
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.setting"
  ],
  "read_only_files": ["examples/**/web/src/services/**/*"],
  "languages": {
    "JavaScript": {
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.organizeImports.oxc": true,
        "source.fixAll.oxc": true
      },
      "prettier": { "allowed": false },
      "formatter": {
        "language_server": {
          "name": "oxc"
        }
      },
      "language_servers": ["!typescript-language-server", "vtsls", "oxc"]
    },
    "TypeScript": {
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.organizeImports.oxc": true,
        "source.fixAll.oxc": true
      },
      "prettier": { "allowed": false },
      "formatter": {
        "language_server": {
          "name": "oxc"
        }
      },
      "language_servers": ["!typescript-language-server", "vtsls", "oxc"]
    },
    "TSX": {
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.organizeImports.oxc": true,
        "source.fixAll.oxc": true
      },
      "prettier": { "allowed": false },
      "formatter": {
        "language_server": {
          "name": "oxc"
        }
      },
      "language_servers": [
        "!typescript-language-server",
        "vtsls",
        "oxc",
        "tailwindcss-language-server"
      ]
    },
    "CSS": {
      "language_servers": ["tailwindcss-intellisense-css", "!vscode-css-language-server"]
    }
  }
}
