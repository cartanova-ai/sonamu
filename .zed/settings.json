{
  "project_name": "Sonamu",
  "lsp": {
    "biome": { "initialization_options": { "disabled": true } },
    "vtsls": {
      "settings": {
        "typescript": {
          "tsserver": { "maxTsServerMemory": 16184 },
          "inlayHints": {
            "parameterNames": {
              "enabled": "all",
              "suppressWhenArgumentMatchesName": false,
            },
            "parameterTypes": {
              "enabled": true,
            },
            "variableTypes": {
              "enabled": true,
              "suppressWhenTypeMatchesName": true,
            },
            "propertyDeclarationTypes": {
              "enabled": true,
            },
            "functionLikeReturnTypes": {
              "enabled": true,
            },
            "enumMemberValues": {
              "enabled": true,
            },
          },
        },
        "javascript": {
          "tsserver": { "maxTsServerMemory": 16184 },
          "inlayHints": {
            "parameterNames": {
              "enabled": "all",
              "suppressWhenArgumentMatchesName": false,
            },
            "parameterTypes": {
              "enabled": true,
            },
            "variableTypes": {
              "enabled": true,
              "suppressWhenTypeMatchesName": true,
            },
            "propertyDeclarationTypes": {
              "enabled": true,
            },
            "functionLikeReturnTypes": {
              "enabled": true,
            },
            "enumMemberValues": {
              "enabled": true,
            },
          },
        },
        "vtsls": {
          "experimental": {
            "maxInlayHintLength": 25
          }
        }
      },
    },
    "tailwindcss-language-server": {
      "settings": {}
    },
    "oxlint": {
      "initialization_options": {
        "settings": {
          "configPath": null,
          "run": "onType",
          "disableNestedConfig": false,
          "fixKind": "safe_fix",
          "unusedDisableDirectives": "deny"
        }
      }
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "fmt.configPath": null,
          "run": "onSave"
        }
      }
    }
  },
  "file_scan_exclusions": [
    ".git/",
    "**/node_modules",
    "packages/app",
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.setting",
  ],
  "read_only_files": ["examples/**/web/src/services/**/*"],
  "languages": {
    "JavaScript": {
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.organizeImports.biome": true,
        "source.fixAll.biome": true,
      },
      "prettier": { "allowed": false },
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "language_servers": ["!typescript-language-server", "!biome", "vtsls", "oxfmt"]
    },
    "TypeScript": {
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.organizeImports.biome": true,
        "source.fixAll.biome": true,
      },
      "prettier": { "allowed": false },
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "language_servers": ["!typescript-language-server", "!biome", "vtsls", "oxfmt"]
    },
    "TSX": {
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.organizeImports.biome": true,
        "source.fixAll.biome": true,
      },
      "prettier": { "allowed": false },
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "language_servers": [
        "!typescript-language-server",
        "!biome",
        "vtsls",
        "oxfmt",
        "tailwindcss-language-server"
      ]
    },
    "CSS": {
      "language_servers": ["tailwindcss-intellisense-css", "!vscode-css-language-server"]
    },
    "JSON": {
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "language_servers": ["oxfmt", "!biome"]
    }
  }
}
