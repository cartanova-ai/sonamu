{
  "id": "Employee",
  "table": "employees",
  "title": "직원",
  "props": [
    { "name": "id", "type": "integer", "desc": "ID" },
    { "name": "created_at", "type": "date", "desc": "등록일시", "dbDefault": "CURRENT_TIMESTAMP" },
    {
      "type": "relation",
      "name": "user",
      "with": "User",
      "desc": "USER",
      "relationType": "OneToOne",
      "hasJoinColumn": true,
      "onUpdate": "CASCADE",
      "onDelete": "CASCADE"
    },
    {
      "type": "relation",
      "name": "department",
      "with": "Department",
      "nullable": true,
      "desc": "부서",
      "relationType": "BelongsToOne",
      "onUpdate": "CASCADE",
      "onDelete": "SET NULL"
    },
    { "name": "employee_number", "desc": "사번", "type": "string", "length": 32 },
    {
      "name": "salary",
      "nullable": true,
      "desc": "SALARY",
      "type": "numeric",
      "precision": 10,
      "scale": 2
    },
    { "name": "hire_date", "type": "date", "nullable": true, "desc": "입사일" },
    { "name": "notes", "type": "string", "nullable": true, "desc": "비고" },
    {
      "type": "relation",
      "name": "projs",
      "with": "Project",
      "nullable": true,
      "desc": "참여중인 프로젝트",
      "relationType": "ManyToMany",
      "joinTable": "projects__employees",
      "onUpdate": "CASCADE",
      "onDelete": "CASCADE"
    }
  ],
  "indexes": [
    {
      "type": "unique",
      "name": "employees_user_id_employee_number_unique",
      "columns": [{ "name": "user_id" }, { "name": "employee_number" }]
    }
  ],
  "subsets": {
