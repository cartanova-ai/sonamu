{
  "id": "User",
  "table": "users",
  "title": "USER",
  "cone": {
    "desc": "사용자",
    "note": "시스템의 모든 사용자를 관리하는 핵심 Entity입니다. 직원과 OneToOne 관계를 가집니다.",
    "tags": ["core", "auth"],
    "fixtureHint": "한국인 이름"
  },
  "props": [
    { "name": "id", "desc": "ID", "type": "string" },
    { "name": "created_at", "type": "date", "desc": "등록일시", "dbDefault": "CURRENT_TIMESTAMP" },
    {
      "name": "email",
      "desc": "이메일",
      "type": "string",
      "length": 255,
      "cone": {
        "desc": "이메일 주소",
        "fixtureHint": "실제 이메일 형식이어야 하며, 도메인은 @test.com 사용 권장함",
        "fixtureGenerator": "faker.internet.email()"
      }
    },
    {
      "name": "username",
      "desc": "이름",
      "type": "string",
      "length": 255,
      "cone": { "fixtureHint": "한글 이름 2-4자", "fixtureGenerator": "faker.person.fullName()" }
    },
    {
      "name": "password",
      "nullable": true,
      "desc": "비밀번호",
      "type": "string",
      "length": 255,
      "cone": { "fixtureDefault": "password123" }
    },
    { "name": "birth_date", "nullable": true, "desc": "생일", "type": "date" },
    { "name": "role", "desc": "ROLE", "type": "enum", "id": "UserRole" },
    { "name": "last_login_at", "nullable": true, "desc": "LASTLOGIN일시", "type": "date" },
    { "name": "bio", "nullable": true, "desc": "BIO", "type": "string" },
    { "name": "is_verified", "type": "boolean", "desc": "ISVERIFIED", "dbDefault": "false" },
    { "name": "deleted_at", "nullable": true, "desc": "삭제일시", "type": "date" },
    {
      "type": "relation",
      "name": "employee",
      "with": "Employee",
      "nullable": true,
      "desc": "직원",
      "relationType": "OneToOne"
    },
    { "name": "image", "type": "string", "nullable": true, "desc": "프로필 이미지" },
    { "name": "updated_at", "type": "date", "dbDefault": "CURRENT_TIMESTAMP", "desc": "수정일시" },
    { "name": "two_factor_enabled", "type": "boolean", "nullable": true, "desc": "2FA 활성화 여부" }
  ],
  "indexes": [{ "type": "unique", "name": "users_email_unique", "columns": [{ "name": "email" }] }],
  "subsets": {
    "A": {
      "fields": [
        "id",
        "created_at",
        "email",
        "username",
        "birth_date",
        "role",
        "last_login_at",
        "bio",
        "is_verified",
        "deleted_at"
      ],
      "cone": { "desc": "SubsetA" }
    },
    "P": [
      "id",
      "email",
      "username",
      "role",
      "bio",
      "is_verified",
      "employee.department.name",
      "employee.salary"
    ],
    "SS": ["id", "created_at", "email", "username", "role", "last_login_at", "bio", "is_verified"]
  },
  "enums": {
    "UserOrderBy": {
      "values": { "id-desc": "ID최신순" },
      "cone": { "note": "사용자를 최신 생성 순서대로 조회함" }
    },
    "UserSearchField": { "id": "ID" },
    "UserRole": { "normal": "노멀", "admin": "관리자" }
  }
}
