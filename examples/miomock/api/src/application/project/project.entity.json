{
  "id": "Project",
  "table": "projects",
  "title": "PROJECT",
  "props": [
    { "name": "id", "type": "integer", "unsigned": true, "desc": "ID" },
    {
      "name": "created_at",
      "type": "timestamp",
      "desc": "등록일시",
      "dbDefault": "CURRENT_TIMESTAMP"
    },
    {
      "type": "relation",
      "name": "employee",
      "with": "Employee",
      "desc": "직원",
      "relationType": "ManyToMany",
      "joinTable": "projects__employees",
      "onUpdate": "CASCADE",
      "onDelete": "CASCADE"
    },
    { "name": "name", "desc": "PROJECT명", "type": "string", "length": 255 },
    {
      "name": "status",
      "desc": "상태",
      "type": "enum",
      "length": 32,
      "id": "ProjectStatus"
    },
    {
      "name": "description",
      "nullable": true,
      "desc": "설명",
      "type": "text",
      "textType": "longtext"
    },
    {
      "name": "budget",
      "type": "decimal",
      "precision": 12,
      "scale": 2,
      "nullable": true,
      "desc": "예산"
    },
    {
      "name": "deadline",
      "type": "datetime",
      "nullable": true,
      "desc": "마감일시"
    },
    {
      "type": "relation",
      "name": "tags",
      "with": "Tag",
      "nullable": true,
      "desc": "TAG리스트",
      "relationType": "ManyToMany",
      "joinTable": "project_tags",
      "onUpdate": "CASCADE",
      "onDelete": "CASCADE"
    },
    {
      "name": "image_urls",
      "nullable": true,
      "desc": "이미지URLS",
      "type": "json",
      "id": "StringArray"
    },
    {
      "name": "virtual_test",
      "nullable": true,
      "desc": "virtual prop test",
      "type": "virtual",
      "id": "NumberType"
    }
  ],
  "indexes": [],
  "subsets": {
    "A": [
      "id",
      "created_at",
      "employee.id",
      "employee.user.email",
      "employee.user.username",
      "employee.department.name",
      "employee.employee_number",
      "employee.salary",
      "name",
      "status",
      "description",
      "budget",
      "deadline",
      "tags.id",
      "tags.name",
      "image_urls",
      "virtual_test"
    ],
    "P": [
      "id",
      "created_at",
      "employee.id",
      "employee.user.email",
      "employee.user.username",
      "employee.department.name",
      "employee.employee_number",
      "name",
      "status",
      "description",
      "budget",
      "deadline",
      "tags.id",
      "tags.name",
      "image_urls"
    ]
  },
  "enums": {
    "ProjectOrderBy": { "id-desc": "ID최신순" },
    "ProjectSearchField": { "id": "ID" },
    "ProjectStatus": {
      "planning": "계획",
      "in_progress": "진행중",
      "completed": "완료",
      "cancelled": "취소"
    }
  }
}
