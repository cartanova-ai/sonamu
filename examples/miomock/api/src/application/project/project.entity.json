{
  "id": "Project",
  "table": "projects",
  "title": "PROJECT",
  "props": [
    { "name": "id", "type": "integer", "desc": "ID" },
    { "name": "created_at", "type": "date", "desc": "등록일시", "dbDefault": "CURRENT_TIMESTAMP" },
    {
      "type": "relation",
      "name": "employee",
      "with": "Employee",
      "desc": "직원",
      "relationType": "ManyToMany",
      "joinTable": "projects__employees",
      "onUpdate": "CASCADE",
      "onDelete": "CASCADE"
    },
    { "name": "name", "desc": "PROJECT명", "type": "string", "length": 255 },
    { "name": "status", "desc": "상태", "type": "enum", "id": "ProjectStatus" },
    { "name": "description", "nullable": true, "desc": "설명", "type": "string" },
    {
      "name": "budget",
      "type": "numeric",
      "precision": 12,
      "scale": 2,
      "nullable": true,
      "desc": "예산"
    },
    { "name": "deadline", "type": "date", "nullable": true, "desc": "마감일시" },
    {
      "type": "relation",
      "name": "tags",
      "with": "Tag",
      "nullable": true,
      "desc": "TAG리스트",
      "relationType": "ManyToMany",
      "joinTable": "project_tags",
      "onUpdate": "CASCADE",
      "onDelete": "CASCADE"
    },
    { "name": "image_urls", "nullable": true, "desc": "이미지URLS", "type": "string[]" },
    {
      "name": "virtual_test",
      "nullable": true,
      "desc": "virtual prop test",
      "type": "virtual",
      "id": "NumberType"
    },
    {
      "name": "textsearchable_index_col",
      "type": "tsvector",
      "desc": "FTS 테스트용",
      "generated": {
        "type": "STORED",
        "expression": "setweight(to_tsvector('simple', coalesce(name, '')), 'A') || setweight(to_tsvector('simple', coalesce(description, '')), 'D')"
      }
    }
  ],
  "indexes": [
    {
      "type": "index",
      "name": "projects_textsearchable_index_col_index",
      "columns": [{ "name": "textsearchable_index_col" }],
      "using": "gin"
    },
    {
      "type": "index",
      "name": "projects_name_description_pgroonga_index",
      "columns": [{ "name": "name" }, { "name": "description" }],
      "using": "pgroonga"
    }
  ],
  "subsets": {
    "A": [
      "id",
      "created_at",
      "employee.id",
      "employee.user.email",
      "employee.user.username",
      "employee.department.name",
      "employee.employee_number",
      "employee.salary",
      "name",
      "status",
      "description",
      "budget",
      "deadline",
      "tags.id",
      "tags.name",
      "image_urls",
      "virtual_test"
    ],
    "P": [
      "id",
      "created_at",
      "employee.id",
      "employee.user.email",
      "employee.user.username",
      "employee.department.name",
      "employee.employee_number",
      "name",
      "status",
      "description",
      "budget",
      "deadline",
      "tags.id",
      "tags.name",
      "image_urls"
    ]
  },
  "enums": {
    "ProjectOrderBy": { "id-desc": "ID최신순" },
    "ProjectSearchField": { "id": "ID" },
    "ProjectStatus": {
      "planning": "계획",
      "in_progress": "진행중",
      "completed": "완료",
      "cancelled": "취소"
    }
  }
}
