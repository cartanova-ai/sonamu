  "modules": {
    "TagModel": "태그 CRUD, 캐시 조회/무효화, 워크플로우 실행을 담당한다",
    "Tag Types": "태그 파라미터/엔티티 스키마를 정의한다",
    "Tag Workflow": "태그 관련 백그라운드 파이프라인을 정의한다"
  },
  "interfaces": {
    "TagModel.findById()": "태그 단건 조회",
    "TagModel.findMany()": "태그 목록 조회",
    "TagModel.save()": "태그 생성/수정",
    "TagModel.del()": "태그 삭제 (관리자 전용)",
    "TagModel.cached()": "태그 기반 캐시 조회",
    "TagModel.deleteCached()": "태그 캐시 무효화",
    "TagModel.runWorkflow()": "태그 워크플로우 실행"
  },
  "dataFlow": [
    "1. 태그 생성/수정 시 기본 이름과 다국어 이름(name_ko, name_en)을 저장한다",
    "2. cached 요청은 캐시 히트 시 즉시 반환하고, 미스 시 DB 조회 후 캐시에 저장한다",
    "3. deleteCached로 캐시를 명시적으로 무효화한다",
    "4. runWorkflow로 태그 백그라운드 워크플로우를 실행한다"
  ],
  "errorHandling": {
    "NotFoundException": "존재하지 않는 태그 조회",
    "ForbiddenException": "권한 없는 삭제 요청은 관리자 가드에서 차단"
  },
  "constraints": [
    "태그 ID는 정수 타입이다",
    "name_ko, name_en은 최대 30자이며 nullable이다",
    "Project와 ManyToMany(project_tags) 관계를 사용한다",
    "@cache 데코레이터 기반 태그 캐시(L1 메모리, TTL 5분)를 적용한다",
    "워크플로우는 다단계 파이프라인(scrape-data -> process-data -> save-data)을 따른다",
    "삭제 인터페이스는 관리자 가드를 필수로 적용한다"
  ]
}
