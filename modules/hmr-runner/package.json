{
  "name": "@sonamu-kit/hmr-runner",
  "type": "module",
  "version": "0.1.1",
  "description": "Runner for applications that use hmr-hook (forked from hot-hook)",
  "author": "CartaNova <dev@cartanova.ai>",
  "repository": {
    "type": "git",
    "url": "https://github.com/cartanova-ai/sonamu.git"
  },
  "license": "MIT",
  "keywords": [
    "hmr-hook",
    "runner",
    "hmr"
  ],
  "main": "build/bin/run.js",
  "bin": "./bin/run.js",
  "files": [
    "build",
    "bin"
  ],
  "scripts": {
    "clean": "del-cli build",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "quick:test": "node --import=./tsnode.esm.js --enable-source-maps bin/test.ts",
    "test": "c8 pnpm quick:test",
    "prepublishOnly": "pnpm lint && pnpm build"
  },
  "dependencies": {
    "@adonisjs/ace": "catalog:",
    "execa": "catalog:"
  },
  "devDependencies": {
    "@adonisjs/tsconfig": "catalog:",
    "@changesets/cli": "catalog:",
    "@japa/assert": "catalog:",
    "@japa/file-system": "catalog:",
    "@japa/runner": "catalog:",
    "@japa/snapshot": "catalog:",
    "@julr/tooling-configs": "catalog:",
    "@swc/core": "catalog:",
    "@types/fs-extra": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "c8": "catalog:",
    "del-cli": "catalog:",
    "desm": "catalog:",
    "execa": "catalog:",
    "fs-extra": "catalog:",
    "p-event": "catalog:",
    "p-timeout": "catalog:",
    "@biomejs/biome": "catalog:",
    "supertest": "catalog:",
    "ts-node": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
