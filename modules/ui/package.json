{
  "name": "@sonamu-kit/ui",
  "version": "0.7.0",
  "description": "SonamuUI — Interactive UI Server Toolkit for Sonamu",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist build && pnpm build:client && pnpm build:node",
    "build:client": "tsc --noEmit && vite build",
    "build:node": "swc node -d dist --config-file node/.swcrc --strip-leading-paths && tsc -p ./node/tsconfig.node.json --emitDeclarationOnly",
    "watch:node": "tsc -w -p ./node/tsconfig.node.json",
    "dev:client": "DEBUG_UI=true vite",
    "dev:node": "tsc-watch -p ./node/tsconfig.node.json --onSuccess \"node --enable-source-maps --import @sonamu-kit/ts-loader --import @sonamu-kit/hmr-hook dist/run-ui.js\"",
    "dev": "DEBUG_UI=true run-p dev:node dev:client"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "build",
    "node",
    "vite.config.ts",
    "entity.instructions.md"
  ],
  "license": "MIT",
  "author": {
    "name": "Minsang Kim",
    "email": "minsangk@me.com",
    "url": "https://twitter.com/minsangk"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.50",
    "@ai-sdk/openai": "^2.0.74",
    "@ai-sdk/react": "^2.0.104",
    "@dagrejs/dagre": "^1.1.8",
    "@fastify/cors": "^8.4.0",
    "@fastify/formbody": "^8.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^6.10.2",
    "@sonamu-kit/hmr-hook": "workspace:^",
    "@sonamu-kit/ts-loader": "workspace:^",
    "@sonamu-kit/react-sui": "workspace:^",
    "@vitejs/plugin-react": "^4.0.3",
    "@xyflow/react": "^12.9.3",
    "ai": "5.0.104",
    "axios": "^1.13.2",
    "chalk": "^4.1.2",
    "classnames": "^2.3.2",
    "debug": "^4.3.7",
    "fastify": "^4.21.0",
    "fastify-qs": "^4.0.2",
    "inflection": "^2.0.1",
    "jotai": "^2.4.2",
    "knex": "^3.1.0",
    "pg": "^8.16.3",
    "prop-types": "^15.8.1",
    "qs": "^6.11.2",
    "radashi": "^12.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "6.3.0",
    "react-syntax-highlighter": "^15.5.0",
    "remark-gfm": "^4.0.0",
    "sass": "^1.65.1",
    "semantic-ui-css": "^2.5.0",
    "semantic-ui-react": "^2.1.4",
    "sonamu": "workspace:^",
    "swr": "^2.2.2",
    "vite": "^7.2.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.13.19",
    "@types/inflection": "^1.13.0",
    "@types/node": "^20.6.3",
    "@types/prop-types": "^15.7.15",
    "@types/qs": "^6.9.8",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "corepack": "^0.34.1",
    "dotenv": "^16.3.1",
    "esbuild": "^0.27.0",
    "npm-run-all": "^4.1.5",
    "tsc-watch": "^6.0.4",
    "tsup": "^8.1.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@sonamu-kit/react-sui": "^0.1.17",
    "sonamu": "^0.7.0"
  }
}
