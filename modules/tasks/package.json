{
  "name": "@sonamu-kit/tasks",
  "version": "0.0.1",
  "type": "module",
  "description": "Sonamu Task - Simple & Distributed Task Queue",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "nodemon exec",
    "build": "swc src --config-file .swcrc -d dist --strip-leading-paths && tsc --emitDeclarationOnly",
    "check": "tsc --noEmit && biome format --write ./src/**/*.ts",
    "check:type": "tsc --noEmit",
    "check:format": "biome format --write ./src/**/*.ts",
    "test": "vitest run",
    "test:watch": "vitest watch --standalone",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ping-alive/sonamu.git"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "knex": "^3.1.0",
    "mysql2": "^3.15.3",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "rou3": "^0.7.10",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.15.3",
    "@types/node": "^24.9.2",
    "nodemon": "^3.1.10",
    "typescript": "^5.9.3",
    "vitest": "^4.0.10"
  },
  "peerDependencies": {
    "knex": "^3.1.0"
  },
  "optionalDependencies": {
    "pg-native": "^3.5.2"
  }
}
