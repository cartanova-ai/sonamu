{
  "name": "@sonamu-kit/tasks",
  "version": "0.1.1",
  "type": "module",
  "description": "Sonamu Task - Simple & Distributed Task Queue",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts"
    },
    "./internal": {
      "import": "./dist/internal.js",
      "types": "./dist/internal.d.ts",
      "development": "./src/internal.ts"
    }
  },
  "scripts": {
    "dev": "nodemon exec",
    "build": "swc src --config-file .swcrc -d dist --strip-leading-paths && tsc --emitDeclarationOnly",
    "check": "tsc --noEmit && biome format --write ./src/**/*.ts",
    "check:type": "tsc --noEmit",
    "check:format": "biome format --write ./src/**/*.ts",
    "pretest": "tsx scripts/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest watch --standalone",
    "test:coverage": "vitest run --coverage"
  },
  "author": "CartaNova <dev@cartanova.ai>",
  "repository": {
    "type": "git",
    "url": "https://github.com/cartanova-ai/sonamu.git"
  },
  "dependencies": {
    "date-fns": "catalog:",
    "date-fns-tz": "catalog:",
    "inflection": "catalog:",
    "knex": "catalog:",
    "node-cron": "catalog:",
    "pg": "catalog:",
    "rou3": "catalog:",
    "uuid": "catalog:",
    "zod": "catalog:",
    "c12": "catalog:"
  },
  "devDependencies": {
    "@types/inflection": "catalog:",
    "@biomejs/biome": "catalog:",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "nodemon": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "knex": "catalog:"
  },
  "optionalDependencies": {
    "pg-native": "catalog:"
  }
}
