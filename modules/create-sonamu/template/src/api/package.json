{
  "name": "create-sonamu-api",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "dev": "sonamu dev",
    "build": "sonamu build",
    "start": "sonamu start",
    "test": "vitest run",
    "test:watch": "vitest watch --standalone",
    "test:coverage": "vitest run --coverage",
    "sonamu": "sonamu",
    "docker:up": "docker compose --env-file .env -f database/docker-compose.yml up -d",
    "docker:down": "docker compose --env-file .env -f database/docker-compose.yml down",
    "dump": "bash database/scripts/dump.sh",
    "seed": "bash database/scripts/seed.sh"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "chalk": "^4",
    "@sonamu-kit/ui": "^0.7.3",
    "dotenv": "^17.2.2",
    "fastify": "^4",
    "knex": "^3.1.0",
    "sonamu": "^0.7.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.5.0",
    "vitest": "^4.0.10"
  }
}
