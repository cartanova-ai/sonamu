{
  "name": "sonamu-project-api",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "dev": "sonamu dev",
    "build": "sonamu build",
    "start": "sonamu start",
    "start:all": "./start.sh",
    "test": "vitest run",
    "test:watch": "vitest watch --standalone",
    "test:coverage": "vitest run --coverage",
    "sonamu": "sonamu",
    "practice": "node dist/practices/$0.js",
    "db:up": "docker compose --env-file .env -f database/docker-compose.yml up -d",
    "db:down": "docker compose --env-file .env -f database/docker-compose.yml down",
    "dump": "bash database/scripts/dump.sh",
    "seed": "bash database/scripts/seed.sh"
  },
  "dependencies": {
    "@swc/core": "^1.13.5",
    "bcrypt": "^6.0.0",
    "chalk": "^4",
    "chokidar": "^4.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.2",
    "fastify": "^4",
    "fastify-file-upload": "^4.0.0",
    "knex": "^3.1.0",
    "pg": "^8.16.3",
    "radashi": "^12.2.0",
    "sonamu": "^0.7.0",
    "zod": "^4.1.12",
    "ai": "^6.0.0-beta.99",
    "@ai-sdk/provider-utils": "4.0.0-beta.40",
    "@ai-sdk/openai": "3.0.0-beta.75",
    "@ai-sdk/provider": "3.0.0-beta.22"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "@sonamu-kit/react-sui": "^0.1.17",
    "@sonamu-kit/ui": "^0.6.0",
    "@swc/cli": "^0.7.8",
    "@types/bcrypt": "^6",
    "@types/node": "^24.5.0",
    "@vitest/coverage-v8": "^4.0.12",
    "node-sql-parser": "^5.3.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.10"
  }
}
