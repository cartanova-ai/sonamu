{
  "name": "create-sonamu-api",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "dev": "sonamu dev",
    "build": "sonamu build",
    "start": "sonamu start",
    "test": "vitest run",
    "test:watch": "vitest watch --standalone",
    "test:coverage": "vitest run --coverage",
    "sonamu": "sonamu",
    "docker:up": "docker compose --env-file .env -f database/docker-compose.yml up -d",
    "docker:down": "docker compose --env-file .env -f database/docker-compose.yml down",
    "dump": "bash database/scripts/dump.sh",
    "seed": "bash database/scripts/seed.sh"
  },
  "dependencies": {
    "@swc/core": "catalog:",
    "fastify": "catalog:",
    "knex": "catalog:",
    "sonamu": "workspace:^",
    "zod": "catalog:",
    "dotenv": "catalog:"
  },
  "devDependencies": {
    "@swc/cli": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
