    "@types/inflection": "^1.13.0",
    "@types/lodash": "^4.14.198",
    "@types/lodash-es": "^4.17.12",
    "@types/luxon": "^3.0.1",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22",
    "@types/prettier": "^3.0.0",
    "@types/prompts": "^2.0.14",
    "@types/qs": "^6.9.7",
    "prettier": "^3.2.5",
    "tsup": "^8.1.0",
    "typescript": "^5.2.2"
  },
  "peerDependencies": {
    "@sonamu-kit/hot-hook": "^0.4.0",
