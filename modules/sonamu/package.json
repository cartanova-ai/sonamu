{
  "name": "sonamu",
  "version": "0.7.53",
  "description": "Sonamu — TypeScript Fullstack API Framework",
  "keywords": [
    "typescript",
    "framework",
    "orm"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./ai": {
      "import": "./dist/ai/index.js",
      "types": "./dist/ai/index.d.ts"
    },
    "./vector": {
      "import": "./dist/vector/index.js",
      "types": "./dist/vector/index.d.ts"
    },
    "./storage": {
      "import": "./dist/storage/index.js",
      "types": "./dist/storage/index.d.ts"
    },
    "./ssr": {
      "import": "./dist/ssr/index.js",
      "types": "./dist/ssr/index.d.ts"
    },
    "./test": {
      "import": "./dist/testing/index.js",
      "types": "./dist/testing/index.d.ts"
    },
    "./cache": {
      "import": "./dist/cache/index.js",
      "types": "./dist/cache/index.d.ts"
    },
    "./ai/providers/rtzr": {
      "import": "./dist/ai/providers/rtzr/index.js",
      "types": "./dist/ai/providers/rtzr/index.d.ts"
    },
    "./ts-loader-register": {
      "default": "./dist/bin/ts-loader-register.js"
    },
    "./hmr-hook-register": {
      "default": "./dist/bin/hmr-hook-register.js"
    },
    "./dict": {
      "import": "./dist/dict/index.js",
      "types": "./dist/dict/index.d.ts"
    },
    "./filter": {
      "import": "./dist/filter/index.js",
      "types": "./dist/filter/index.d.ts"
    }
  },
  "scripts": {
    "dev": "nodemon exec",
    "prebuild": "tsx ../../scripts/hard-link.ts",
    "build": "run-s 'build:sonamu' 'build:ui-web'",
    "build:sonamu": "rm -rf dist && swc src -d dist --strip-leading-paths && tsc --emitDeclarationOnly",
    "build:ui-web": "cd ui-web && pnpm install && pnpm build",
    "test:type": "vitest --typecheck test-d.ts"
  },
  "license": "MIT",
  "author": {
    "name": "CartaNova <dev@cartanova.ai>",
    "url": "https://cartanova.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cartanova-ai/sonamu.git"
  },
  "bin": "./bin/cli.js",
  "files": [
    "dist",
    "src",
    "bin",
    ".swcrc.project-default"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/lib-storage": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@better-auth/sso": "catalog:",
    "@biomejs/js-api": "catalog:",
    "@biomejs/wasm-nodejs": "catalog:",
    "@fastify/compress": "catalog:",
    "@fastify/cors": "catalog:",
    "@fastify/formbody": "catalog:",
    "@fastify/middie": "catalog:",
    "@fastify/multipart": "catalog:",
    "@fastify/passport": "catalog:",
    "@fastify/static": "catalog:",
    "@logtape/fastify": "catalog:",
    "@logtape/logtape": "catalog:",
    "@logtape/pretty": "catalog:",
    "@logtape/redaction": "catalog:",
    "@sonamu-kit/hmr-hook": "workspace:^",
    "@sonamu-kit/hmr-runner": "workspace:^",
    "@sonamu-kit/tasks": "workspace:^",
    "@sonamu-kit/ts-loader": "workspace:^",
    "@swc/core": "catalog:",
    "better-auth": "catalog:",
    "bentocache": "catalog:",
    "chalk": "catalog:",
    "chokidar": "catalog:",
    "date-fns-tz": "catalog:",
    "dotenv": "catalog:",
    "exceljs": "catalog:",
    "fast-deep-equal": "catalog:",
    "fastify": "catalog:",
    "fastify-qs": "catalog:",
    "fastify-sse-v2": "catalog:",
    "flydrive": "catalog:",
    "inflection": "catalog:",
    "knex": "catalog:",
    "mime-types": "catalog:",
    "minimatch": "catalog:",
    "node-cron": "catalog:",
    "node-sql-parser": "catalog:",
    "pg": "catalog:",
    "prompts": "catalog:",
    "qs": "catalog:",
    "radashi": "catalog:",
    "tsicli": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@swc/cli": "catalog:",
    "@types/inflection": "catalog:",
    "@types/mime-types": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/prompts": "catalog:",
    "@types/qs": "catalog:",
    "nodemon": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "@ai-sdk/provider": "catalog:",
    "@ai-sdk/provider-utils": "catalog:",
    "@better-auth/sso": "catalog:",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "ai": "catalog:",
    "better-auth": "catalog:",
    "fastify": "catalog:",
    "ioredis": "catalog:",
    "knex": "catalog:",
    "pgvector": "catalog:",
    "typescript": "catalog:",
    "voyageai": "catalog:"
  },
