{
  "name": "sonamu",
  "version": "0.5.6",
  "description": "Sonamu — TypeScript Fullstack API Framework",
  "keywords": [
    "typescript",
    "framework",
    "orm"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "nodemon exec",
    "build": "rm -rf dist && swc src -d dist --strip-leading-paths && tsc --emitDeclarationOnly",
    "publish": "yarn build && yarn npm publish"
  },
  "license": "MIT",
  "author": {
    "name": "Minsang Kim",
    "email": "minsangk@me.com",
    "url": "https://twitter.com/minsangk"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ping-alive/sonamu.git"
  },
  "bin": "./dist/bin/cli-wrapper.js",
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.921.0",
    "@aws-sdk/s3-request-presigner": "^3.921.0",
    "@fastify/cors": "^8.1.0",
    "@fastify/formbody": "^7.1.0",
    "@fastify/multipart": "^8",
    "@fastify/passport": "^2.2.0",
    "@fastify/secure-session": "^5.2.0",
    "@fastify/static": "^7",
    "@swc/core": "^1.13.19",
    "chalk": "^4.1.2",
    "chokidar": "^4.0.3",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.0.2",
    "fast-deep-equal": "^3.1.3",
    "fastify": "^4.23.2",
    "fastify-qs": "^4.0.0",
    "fastify-sse-v2": "^4.2.1",
    "flydrive": "^1.3.0",
    "inflection": "^1.13.2",
    "knex": "^3.1.0",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "luxon": "^3.0.3",
    "mime-types": "^3.0.1",
    "minimatch": "^10.0.3",
    "mysql2": "^3.6.1",
    "node-sql-parser": "^5.2.0",
    "nodemon": "^3.1.10",
    "prompts": "^2.4.2",
