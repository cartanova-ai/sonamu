{
  "name": "sonamu",
  "version": "0.7.21",
  "description": "Sonamu — TypeScript Fullstack API Framework",
  "keywords": [
    "typescript",
    "framework",
    "orm"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./ai": {
      "import": "./dist/ai/index.js",
      "types": "./dist/ai/index.d.ts"
    },
    "./vector": {
      "import": "./dist/vector/index.js",
      "types": "./dist/vector/index.d.ts"
    },
    "./storage": {
      "import": "./dist/storage/index.js",
      "types": "./dist/storage/index.d.ts"
    },
    "./test": {
      "import": "./dist/testing/index.js",
      "types": "./dist/testing/index.d.ts"
    },
    "./ai/providers/rtzr": {
      "import": "./dist/ai/providers/rtzr/index.js",
      "types": "./dist/ai/providers/rtzr/index.d.ts"
    },
    "./ts-loader-register": {
      "default": "./dist/bin/ts-loader-register.js"
    },
    "./hmr-hook-register": {
      "default": "./dist/bin/hmr-hook-register.js"
    }
  },
  "scripts": {
    "dev": "nodemon exec",
    "build": "run-s 'build:sonamu' 'build:ui-web'",
    "build:sonamu": "rm -rf dist && swc src -d dist --strip-leading-paths && tsc --emitDeclarationOnly",
    "build:ui-web": "cd ui-web && pnpm install && pnpm build",
    "test:type": "vitest --typecheck test-d.ts"
  },
  "license": "MIT",
  "author": {
    "name": "CartaNova <dev@cartanova.ai>",
    "url": "https://cartanova.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cartanova-ai/sonamu.git"
  },
  "bin": "./bin/cli.js",
  "files": [
    "dist",
    "src",
    "bin",
    ".swcrc.project-default"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.921.0",
    "@aws-sdk/s3-request-presigner": "^3.921.0",
    "@biomejs/js-api": "^4.0.0",
    "@biomejs/wasm-nodejs": "^2.3.7",
    "@fastify/cors": "^8.1.0",
    "@fastify/formbody": "^7.1.0",
    "@fastify/multipart": "^8",
    "@fastify/passport": "^2.2.0",
    "@fastify/secure-session": "^7",
    "@fastify/static": "^7",
    "@sonamu-kit/hmr-hook": "workspace:^",
    "@sonamu-kit/hmr-runner": "workspace:^",
    "@sonamu-kit/tasks": "workspace:^",
    "@sonamu-kit/ts-loader": "workspace:^",
    "@swc/core": "^1.13.19",
    "chalk": "^4.1.2",
    "chokidar": "^4.0.3",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.0.2",
    "fast-deep-equal": "^3.1.3",
    "fastify": "^4.23.2",
    "fastify-qs": "^4.0.0",
    "fastify-sse-v2": "^4.2.1",
    "flydrive": "^1.3.0",
    "inflection": "^1.13.2",
    "knex": "^3.1.0",
    "mime-types": "^3.0.1",
    "minimatch": "^10.0.3",
    "node-cron": "^4.2.1",
    "node-sql-parser": "^5.2.0",
    "pg": "^8.16.3",
    "prompts": "^2.4.2",
    "qs": "^6.11.0",
    "radashi": "^12.2.0",
    "tsicli": "^1.0.5",
    "vitest": "^4.0.10",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "@swc/cli": "^0.7.8",
    "@types/inflection": "^1.13.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22",
    "@types/pg": "^8.15.6",
    "@types/prompts": "^2.0.14",
    "@types/qs": "^6.9.7",
    "nodemon": "3.1.10",
    "tsup": "^8.1.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@ai-sdk/openai": "3.0.0",
    "@ai-sdk/provider": "3.0.0",
    "@ai-sdk/provider-utils": "4.0.0",
    "@ai-sdk/anthropic": "3.0.0",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.13.5",
    "ai": "6.0.1",
    "fastify": "^4.23.2",
    "knex": "^3.1.0",
    "pgvector": "^0.2.1",
    "typescript": "^5.9.3",
    "voyageai": "^0.0.8"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/provider": {
      "optional": true
    },
    "@ai-sdk/provider-utils": {
      "optional": true
    },
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "pgvector": {
      "optional": true
    },
    "voyageai": {
      "optional": true
    }
  }
}
