{
  "name": "@sonamu-kit/cdd",
  "version": "0.2.0",
  "description": "CDD(Contract-Driven Development) CLI tool for Sonamu projects",
  "license": "MIT",
  "author": "CartaNova <dev@cartanova.ai>",
  "repository": {
    "type": "git",
    "url": "https://github.com/cartanova-ai/sonamu.git"
  },
  "bin": {
    "cdd": "./dist/index.js"
  },
  "files": [
    "dist",
    "src/agents"
  ],
  "type": "module",
  "main": "./dist/lib.js",
  "exports": {
    ".": {
      "import": "./dist/lib.js",
      "types": "./dist/lib.d.ts",
      "development": "./src/lib.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly",
    "check": "tsc --noEmit && oxlint src && oxfmt --check src",
    "check:type": "tsc --noEmit",
    "check:format": "oxfmt src",
    "test": "vitest run",
    "test:watch": "vitest watch --standalone"
  },
  "dependencies": {
    "chalk": "catalog:",
    "fast-glob": "catalog:",
    "minimist": "catalog:"
  },
  "devDependencies": {
    "@types/minimist": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
