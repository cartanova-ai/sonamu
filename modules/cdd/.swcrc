{
  "$schema": "https://swc.rs/schema.json",
  "module": {
    "type": "es6",
    "resolveFully": true
  },
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": true
    },
    "baseUrl": ".",
    "target": "esnext"
  },
  "minify": false,
  "sourceMaps": "inline",
  "inlineSourcesContent": true
}
