{
  "name": "@sonamu-kit/ts-loader",
  "type": "module",
  "version": "2.1.3",
  "exports": {
    ".": "./dist/register.js",
    "./loader": "./dist/loader.js"
  },
  "imports": {
    "#ts/*": "./dist/*.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -b",
    "test": "node --no-warnings --experimental-vm-modules --enable-source-maps --test-reporter=spec --test 'dist/__tests__/**/*.js'",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@loaderkit/resolve": "^1.0.4",
    "@swc/core": "^1.13.5",
    "json5": "^2.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
