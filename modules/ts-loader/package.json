{
  "name": "@sonamu-kit/ts-loader",
  "version": "2.1.3",
  "author": "CartaNova <dev@cartanova.ai>",
  "repository": {
    "type": "git",
    "url": "https://github.com/cartanova-ai/sonamu.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#ts/*": "./dist/*.js"
  },
  "exports": {
    ".": "./dist/register.js",
    "./loader": "./dist/loader.js"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b",
    "test": "node --no-warnings --experimental-vm-modules --enable-source-maps --test-reporter=spec --test 'dist/__tests__/**/*.js'",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@loaderkit/resolve": "catalog:",
    "@swc/core": "catalog:",
    "json5": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
