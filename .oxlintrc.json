{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./.oxlintrc.base.json"],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "dist/**",
    "build/**",
    "node_modules/**",
    "examples/**/web/src/services/**/*",
    "modules/create-sonamu/template/**",
    "**/*.gen.ts",
    "**/*.generated.ts",
    "**/*.generated.tsx"
  ]
}
