{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./.oxlintrc.base.json"],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**",
    "modules/create-sonamu/template/src/tools/oxlint/anti-slop/**",
    "dist/**",
    "build/**",
    "node_modules/**",
    "examples/**/web/src/services/**/*",
    "**/*.gen.ts",
    "**/*.generated.ts",
    "**/*.generated.tsx"
  ]
}
